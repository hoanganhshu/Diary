<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

  >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/weathernoti"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/sdp_43"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_weather"
        android:layout_marginTop="@dimen/sdp_16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/sdp_10"
        android:paddingStart="@dimen/sdp_10"
        android:paddingEnd="@dimen/sdp_10">

        <ImageView
            android:id="@+id/iconWeather"
            android:layout_width="@dimen/sdp_20"
            app:layout_constraintTop_toTopOf="parent"

            app:layout_constraintStart_toStartOf="parent"

            android:layout_height="@dimen/sdp_20"
            app:layout_constraintBottom_toBottomOf="parent"

            android:src="@drawable/icon_sun" />

        <TextView
            android:id="@+id/tvCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hanoi"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/iconWeather"
            android:layout_marginStart="8dp"

            app:layout_constraintTop_toTopOf="@id/iconWeather"
            app:layout_constraintBottom_toBottomOf="@id/iconWeather"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTemp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/tvCity"
            app:layout_constraintTop_toTopOf="@id/iconWeather"
            app:layout_constraintBottom_toBottomOf="@id/iconWeather"
            android:text="18 °C"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDiaries"
        android:layout_width="@dimen/sdp_0"
        android:layout_height="@dimen/sdp_0"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/sdp_20"
        app:layout_constraintTop_toBottomOf="@id/weathernoti"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/emtyView"
         />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/emtyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sdp_13"
        android:background="@drawable/union"
        android:visibility="gone"
        android:layout_marginHorizontal="@dimen/_30sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingVertical="30dp"
        app:layout_constraintEnd_toEndOf="parent">



            <ImageView
                android:id="@+id/imgTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sdp_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/group" />

            <TextView
                android:layout_width="match_parent"
                android:fontFamily="@font/nunito_semibold"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/imgTop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="15dp"
                android:text="@string/write_your_first"
                android:layout_marginHorizontal="20dp"
                android:textColor="#BD98EA"
                android:textSize="14sp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
