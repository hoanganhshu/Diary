<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_260sdp"
    android:layout_height="@dimen/_130sdp"
    android:padding="@dimen/_16sdp"
    android:background="@drawable/bg_pin_dialog">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your PIN is:"
        android:textColor="#B086F9"
        android:textSize="@dimen/_15sdp"
        android:fontFamily="@font/nutino_extrabold"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/pinContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvPin1"
            style="@style/PinCircle" />

        <TextView
            android:id="@+id/tvPin2"
            style="@style/PinCircle" />

        <TextView
            android:id="@+id/tvPin3"
            style="@style/PinCircle" />

        <TextView
            android:id="@+id/tvPin4"
            style="@style/PinCircle" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
