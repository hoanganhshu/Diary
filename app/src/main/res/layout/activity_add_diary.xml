<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavAddDiary">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@drawable/arrow_back"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp"/>


    <TextView
        android:id="@+id/btnSave"
        android:layout_width="84dp"
        android:gravity="center"
        android:layout_height="32dp"
        android:text="@string/save"
        android:textSize="14sp"

        android:fontFamily="@font/nunito_bold"
        android:textColor="?attr/colorPrimary"
        android:background="@drawable/bg_applied"

        app:cornerRadius="16dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_margin="16dp"

        />


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEntry"
        android:layout_width="match_parent"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="10dp"
        android:layout_height="wrap_content"
        android:minHeight="220dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"

        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"

    >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="@dimen/_0sdp"
                    android:id="@+id/constraintday"

                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_height="wrap_content"
                        android:text="day"

                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/black"
                        android:textStyle="bold"



                        android:id="@+id/day"
                        android:paddingTop="5dp"
                        android:paddingLeft="5dp"


                        android:textSize="@dimen/_14sdp"
                        app:layout_constraintStart_toStartOf="parent"

                        />

                    <ImageView
                        android:layout_width="wrap_content"
                        app:layout_constraintTop_toBottomOf="parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/customselectday"
                        android:layout_marginTop="@dimen/_17sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/x"

                        app:layout_constraintStart_toEndOf="@+id/day"


                        />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toEndOf="@+id/x"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/month"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"

                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/month"
                            android:textSize="@dimen/_14sdp"
                            android:textColor="@color/black"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/drop"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/emoji"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginRight="10dp"
                    android:background="@drawable/emoji_back" />
            </LinearLayout>




            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/title"
                android:textStyle="bold"
                android:fontFamily="@font/nutino_extrabold"
                android:background="@android:color/transparent"
                android:textSize="19sp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"/>


            <EditText
                android:id="@+id/edtContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="top|start"
                android:fontFamily="@font/nunito_medium"
                android:textSize="15dp"
                android:hint="@string/starting_here"
                android:background="@android:color/transparent"
                android:inputType="textMultiLine"
                android:minLines="3"/>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvImages"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="10dp"

                android:overScrollMode="never"
                android:visibility="gone"/>


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>



        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:id="@+id/bottomNavAddDiary"
        app:itemGravity="center"
        app:itemIconSize="18dp"
        app:itemBackground="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_menu_adddiary"
        app:labelVisibilityMode="unlabeled"
        app:itemHorizontalTranslationEnabled="false"
        app:itemRippleColor="@android:color/transparent"
        app:itemIconTint="@color/bottom_nav_color_state"


        />

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:alpha="0.45"
        android:background="@drawable/dot_security"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">


            <FrameLayout
                android:id="@+id/stateCircle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">


                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressCircle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    app:indicatorSize="96dp"
                    app:trackThickness="6dp"
                    app:indicatorColor="#54E346"
                    app:trackColor="#33FFFFFF"/>



                <ImageView
                    android:id="@+id/imgDone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"

                    android:visibility="gone"
                    android:background="@drawable/done"
                    android:backgroundTint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Saving..."
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>






</androidx.constraintlayout.widget.ConstraintLayout>
