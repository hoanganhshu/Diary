<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/skip"
        android:textStyle="bold"
        android:fontFamily="@font/nunito_bold"
        android:textColor="#AAAABB"
        android:layout_marginTop="@dimen/sdp_31"
        android:layout_marginEnd="@dimen/sdp_19"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/progressDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="@dimen/sdp_36"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="@dimen/sdp_16"
            android:layout_height="@dimen/sdp_6"
            android:background="@drawable/dotfilled" />

        <View
            android:id="@+id/dot2"
            android:layout_width="@dimen/sdp_6"
            android:layout_height="@dimen/sdp_6"
            android:layout_marginStart="@dimen/sdp_6"
            android:background="@drawable/dot" />

        <View
            android:id="@+id/dot3"
            android:layout_width="@dimen/sdp_6"
            android:layout_height="@dimen/sdp_6"
            android:layout_marginStart="@dimen/sdp_6"
            android:background="@drawable/dot" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="@dimen/sdp_280"
        android:layout_height="@dimen/sdp_49"
        android:text="@string/continute"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:enabled="false"
        android:background="@drawable/btn_continue_selector"
        app:backgroundTint="@null"
        android:fontFamily="@font/nunito_bold"
        app:cornerRadius="@dimen/sdp_28"
        android:layout_marginBottom="@dimen/sdp_22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

</layout>