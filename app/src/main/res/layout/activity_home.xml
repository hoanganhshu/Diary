<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools">
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:paddingTop="@dimen/_15sdp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

   >


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:layout_height="60dp"

        android:background="@android:color/transparent"

        app:title="@string/my_diary"
        app:titleTextAppearance="@style/ToolbarTitleText"


        app:menu="@menu/appbar_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
         />
    <FrameLayout
        android:id="@+id/overlayOnAppbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"

        app:layout_constraintTop_toTopOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="@id/topAppBar"
        app:layout_constraintEnd_toEndOf="@id/topAppBar">

        <LinearLayout
            android:id="@+id/btnCalendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="9dp"

            android:orientation="horizontal"
            android:layout_marginEnd="100dp"
            android:gravity="center"
            android:background="@drawable/bg_calendar_button">

            <ImageView
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_marginVertical="6dp"
                android:src="@drawable/calendarimage"
                android:id="@+id/ivCalendar"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calendar"

                android:fontFamily="@font/nunito_bold"
                android:id="@+id/tvCalendar"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </FrameLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <com.diary.app.demo.util.CurvedBottomNavigationView
        android:id="@+id/curve_bg"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:elevation="2dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="4dp"
        app:menu="@menu/bottom_menu"
        app:itemIconTint="@color/bnv_tint"
        app:itemRippleColor="@null"

        android:paddingTop="20dp"
        app:itemIconSize="17dp"
        app:itemBackground="@android:color/transparent"


        app:itemTextColor="@color/bnv_tint"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent" />





    <ImageButton
        android:id="@+id/centerButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/plus"
        android:background="@drawable/center_btn"
        android:elevation="6dp"
        android:scaleType="centerInside"

        app:layout_constraintBottom_toBottomOf="@id/curve_bg"
        android:layout_marginBottom="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>

</layout>