<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"

    android:padding="@dimen/_20sdp"
    >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="@dimen/_0sdp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nutino_extrabold"
            android:layout_weight="1"
            android:text="@string/how_are_you"
            android:textSize="18sp"
           android:gravity="center"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:src="@drawable/close"
            />
    </LinearLayout>


    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/_16sdp" />
    <GridLayout
        android:id="@+id/gridMoods"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"

        android:columnCount="4"
        android:rowCount="2"


        android:alignmentMode="alignMargins"
        android:layout_margin="@dimen/_16sdp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/mood1"
            android:layout_width="56dp"
            android:layout_margin="@dimen/_6sdp"

            android:layout_height="56dp"

            android:src="@drawable/emoj1"
            />

        <ImageView
            android:id="@+id/mood2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="@dimen/_6sdp"

            android:src="@drawable/emoj2"

            />

        <ImageView
            android:id="@+id/mood3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="@dimen/_6sdp"

            android:src="@drawable/emoj3"

            />

        <ImageView
            android:id="@+id/mood4"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="@dimen/_6sdp"

            android:src="@drawable/emoj4"
            />

        <ImageView
            android:id="@+id/mood5"
            android:layout_width="56dp"
            android:layout_margin="@dimen/_6sdp"

            android:layout_height="56dp"
            android:src="@drawable/emoj5"

            />

        <ImageView
            android:id="@+id/mood6"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="@dimen/_6sdp"

            android:src="@drawable/emoj6"

            />

        <ImageView
            android:id="@+id/mood7"
            android:layout_width="56dp"
            android:layout_margin="@dimen/_6sdp"

            android:layout_height="56dp"
            android:src="@drawable/emoj7"

            />

        <ImageView
            android:id="@+id/mood8"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="@dimen/_6sdp"


            android:src="@drawable/emoj8"
            />
    </GridLayout>


    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/_16sdp" />

    <LinearLayout
        android:id="@+id/seeMoreRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/seemore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/see_more"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp" />


        <FrameLayout
            android:id="@+id/moodPreviewStack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp">

            <ImageView
                android:id="@+id/preview1"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic1"

                android:background="@drawable/bg_emoji"
                />

            <ImageView
                android:id="@+id/preview2"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginStart="@dimen/_14sdp"
                android:src="@drawable/ic2"
                android:padding="@dimen/_5sdp"
                android:background="@drawable/bg_emoji"
                />

            <ImageView
                android:id="@+id/preview3"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginStart="@dimen/_28sdp"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic3"
                android:background="@drawable/bg_emoji"
                 />
        </FrameLayout>

        <ImageView
            android:id="@+id/seeMoreArrow"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:backgroundTint="?attr/colorPrimary"

            android:background="@drawable/mui_ten"
           />

    </LinearLayout>


</LinearLayout>
