<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="corner_16" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/sdp_16</item>
    </style>

    <style name="ToolbarTitleText">
        <item name="android:fontFamily">@font/nutino_extrabold</item>
        <item name="android:textSize">@dimen/_18sdp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TabTextAppearance"
        parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/nutino_extrabold</item>
    </style>

    <!-- Style cho ô tiêu đề thứ trong tuần của custom calendar -->
    <style name="CalDayHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFFCC</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
