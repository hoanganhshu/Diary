    <style name="OnbOptionSingle" parent="@style/OnbOption">

        <item name="strokeColor">@color/purple_500</item>
        <item name="cornerRadius">@dimen/_16sdp</item>
        <item name="strokeWidth">@dimen/_2sdp</item>
    </style>

    <style name="PinCircle">
        <item name="android:layout_width">@dimen/_45sdp</item>
        <item name="android:layout_height">@dimen/_45sdp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_pin_circle</item>
    </style>
    <style name="ToggleButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">@dimen/_48sdp</item>
        <item name="android:layout_height">@dimen/_48sdp</item>

        <!-- Dùng tint theo state checked -->
        <item name="backgroundTint">@color/toggle_button_selector</item>

        <!-- Bo góc bằng ShapeAppearance -->
        <item name="shapeAppearanceOverlay">@style/ToggleButton.Shape</item>

        <item name="iconTint">@color/icon_selector</item>
        <item name="iconPadding">@dimen/_0sdp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="ToggleButton.Style" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>

        <!-- Dùng selector màu thay vì drawable background -->
        <item name="backgroundTint">@color/toggle_button_selector</item>

        <!-- Bo góc giống nút cũ -->
        <item name="shapeAppearanceOverlay">@style/ToggleButton.Shape</item>

        <item name="iconTint">@color/icon_selector</item>
        <item name="iconPadding">@dimen/_0sdp</item>
        <item name="iconGravity">textStart</item>
    </style>



    <style name="ToggleButton.Shape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>





</resources>
