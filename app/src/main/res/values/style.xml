<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="OnbOption" parent="Widget.MaterialComponents.Button.OutlinedButton">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_marginTop">14dp</item>


        <item name="cornerRadius">@dimen/_16sdp</item>


        <item name="backgroundTint">@android:color/white</item>


        <!-- Viền (stroke) -->
        <item name="strokeColor">@color/purple_500</item>
        <item name="strokeWidth">@dimen/_1sdp</item>

        <!-- Chữ -->
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>

        <item name="android:textSize">16sp</item>


        <item name="rippleColor">@color/purple_500</item>
    </style>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="searchViewStyle">@style/MySearchViewStyle</item>
    </style>

    <style name="MySearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="closeIcon">@null</item>
    </style>

    <style name="CalendarDateSelected">
        <item name="android:background">@drawable/calendar_date_selected</item>
        <item name="android:textColor">#000000</item>
    </style>
    <style name="KeypadButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_gravity">center</item>

        <!-- nền nút -->
        <item name="android:background">@drawable/keypad_button_bg</item>

        <!-- TẮT tint để không đè lên background -->


        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MyPopupMenu" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">@android:color/black</item>
    </style>




